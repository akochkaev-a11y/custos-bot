[Unit]
Description=Custos private Telegram archive
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=custos
Group=custos
WorkingDirectory=/opt/custos
ExecStart=/usr/bin/python3 /opt/custos/custos.py
Environment=CUSTOS_CONFIG=/etc/custos/config.json
Restart=on-failure
RestartSec=10
TimeoutStopSec=90
UMask=0077
StateDirectory=custos
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
MemoryMax=384M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
